# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=buzzer
POSTGRES_USER=buzzer
POSTGRES_PASSWORD=buzzer_secret

# Twitter/X API (OAuth 2.0 - required for tweeting)
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# App config
BUZZER_HASHTAG=#MarchMadness
# Optional: healthchecks.io ping URL — leave blank to disable
HEALTHCHECK_URL=
DRY_RUN=false
# Run once and exit instead of staying alive on a cron schedule
SINGLE_RUN=false
LOG_LEVEL=info
POLL_INTERVAL_MINUTES=2
